datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  CAREGIVER
  SPECIALIST
  ADMIN
}

enum DiabetesType {
  TYPE_1
  TYPE_2
  NONE
}

enum MetricType {
  BLOOD_GLUCOSE
  HBA1C
  BLOOD_PRESSURE
  WEIGHT
}

enum ScheduleType {
  MEDICATION
  FEEDING
}

model User {
  id             String          @id @default(uuid())
  fullName       String
  phone          String          @unique
  email          String?         @unique
  passwordHash   String
  role           Role            @default(PATIENT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  patientProfile PatientProfile?
  vitalLogs      VitalLog[]
  schedules      Schedule[]
}

model PatientProfile {
  id                    String        @id @default(uuid())
  userId                String        @unique
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Medical Biodata Fields
  emergencyContactName  String?
  emergencyContactPhone String?
  diagnosisYear         Int?
  diabetesType          DiabetesType  @default(NONE)
  gender                String?
  dateOfBirth           DateTime?
  
  // Type 1 Conditional Fields (Snapshot / Latest)
  bloodGlucoseLevel     Float?        // mg/dL
  bloodGlucoseLoggedAt  DateTime?     
  
  // Type 2 Conditional Fields (Snapshot / Latest)
  hba1c                 Float?        // %
  bloodPressure         String?       // e.g. "120/80"
  weight                Float?        // Optional in kg
  
  isProfileComplete     Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model VitalLog {
  id                    String        @id @default(uuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  MetricType
  detail                String
  value                 Float?
  systolic              Int?
  diastolic             Int?
  verified              Boolean       @default(true)
  loggedAt              DateTime      @default(now())
}

model Schedule {
  id                    String        @id @default(uuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  ScheduleType
  name                  String
  time                  String
  createdAt             DateTime      @default(now())
}