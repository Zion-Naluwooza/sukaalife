datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  CAREGIVER
  SPECIALIST
  ADMIN
}

enum DiabetesType {
  TYPE_1
  TYPE_2
  NONE
}

enum MetricType {
  BLOOD_GLUCOSE
  HBA1C
  BLOOD_PRESSURE
  WEIGHT
}

enum ScheduleType {
  MEDICATION
  FEEDING
}

enum GoalCategory {
  GLUCOSE
  MEDICATION
  EXERCISE
  DIET
  GENERAL
}

enum MoodState {
  VERY_GOOD
  GOOD
  NEUTRAL
  TIRED
  STRESSED
  DIZZY
  UNWELL
}

model User {
  id                String             @id @default(uuid())
  fullName          String
  phone             String             @unique
  email             String?            @unique
  passwordHash      String
  role              Role               @default(PATIENT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  patientProfile    PatientProfile?
  vitalLogs         VitalLog[]
  schedules         Schedule[]
  healthGoals       HealthGoal[]
  achievements      Achievement[]
  moodLogs          MoodLog[]
  consultationNotes ConsultationNote[]
}

model PatientProfile {
  id                    String        @id @default(uuid())
  userId                String        @unique
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Medical Biodata Fields
  emergencyContactName  String?
  emergencyContactPhone String?
  diagnosisYear         Int?
  diabetesType          DiabetesType  @default(NONE)
  gender                String?
  dateOfBirth           DateTime?
  
  // Type 1 Conditional Fields (Snapshot / Latest)
  bloodGlucoseLevel     Float?        // mg/dL
  bloodGlucoseLoggedAt  DateTime?     
  
  // Type 2 Conditional Fields (Snapshot / Latest)
  hba1c                 Float?        // %
  bloodPressure         String?       // e.g. "120/80"
  weight                Float?        // Optional in kg
  
  isProfileComplete     Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model VitalLog {
  id                    String        @id @default(uuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  MetricType
  detail                String
  value                 Float?
  systolic              Int?
  diastolic             Int?
  verified              Boolean       @default(true)
  loggedAt              DateTime      @default(now())
}

model Schedule {
  id                    String        @id @default(uuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  ScheduleType
  name                  String
  time                  String
  createdAt             DateTime      @default(now())
}

model HealthGoal {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  targetValue     Int           // e.g. 14 checks per week
  currentProgress Int           @default(0)
  unit            String        // e.g. "times", "days", "mins", "logs"
  category        GoalCategory  @default(GENERAL)
  isCompleted     Boolean       @default(false)
  weekStartDate   DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Achievement {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeKey        String        // e.g. "FIRST_LOG", "STREAK_7", "GOAL_CRUSHER"
  title           String
  description     String
  iconName        String        // e.g. "Trophy", "Award", "Flame", "Star"
  unlockedAt      DateTime      @default(now())
}

model MoodLog {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood        MoodState
  energyLevel Int?       // 1 to 5 scale
  symptoms    String?    // e.g. "Headache, Shakiness"
  notes       String?
  loggedAt    DateTime   @default(now())
}

model ConsultationNote {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorName      String?
  clinicName      String?
  visitDate       DateTime  @default(now())
  chiefReason     String?
  doctorAdvice    String
  prescriptions   String?
  nextAppointment DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}